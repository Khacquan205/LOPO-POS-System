# Sao chép file này thành .env rồi điền IP máy của bạn
#
# Android Simulator : dùng 10.0.2.2
# iOS/Android thật  : dùng LAN IP của máy (vd: 192.168.1.x)
#   Windows: ipconfig -> IPv4 Address
#   macOS  : ifconfig | grep "inet "

# Ví dụ:
# Máy ảo: EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api
# Máy thật: EXPO_PUBLIC_API_BASE_URL= http://192.168.88.50:3000/api
